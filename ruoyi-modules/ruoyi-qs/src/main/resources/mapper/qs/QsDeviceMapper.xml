        <foreach collection="deviceList" item="item" open="(" separator="," close=")">
            #{item.id}
        </foreach>
    </update>

    <update id="updateParentIdByDeviceList">
        UPDATE qs_device
        SET gb_parent_id = #{parentId}
        WHERE id IN
