        WHERE id IN
        <foreach collection="deviceList" item="item" open="(" separator="," close=")">
            #{item.id}
        </foreach>
    </update>

    <update id="updateRegion">
        UPDATE qs_device
        SET gb_civil_code = #{civilCode}
        WHERE id IN
        <foreach collection="deviceList" item="item" open="(" separator="," close=")">
            #{item.id}
        </foreach>
    </update>

    <update id="removeCivilCodeByDeletes">
        UPDATE qs_device
